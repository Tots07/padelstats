rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ⚠️ REMPLACE par l'adresse Gmail de l'admin, en minuscules.
    function isAdmin() {
      return signedIn()
        && request.auth.token.get('email', '') == 'ton.adresse@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }

    function claimPath() {
      return /databases/$(database)/documents/claims/$(request.auth.uid);
    }
    // Un invité "connecté" = appareil ayant choisi un profil avec le bon code.
    function hasClaim() { return signedIn() && exists(claimPath()); }
    function myPlayer() { return get(claimPath()).data.playerId; }

    // Joueurs : lisibles par tout compte connecté (pour « Qui es-tu ? »).
    // Un invité peut en créer ; il ne modifie/supprime que ceux qu'il a créés.
    // L'admin peut tout.
    match /players/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (hasClaim() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
        || (hasClaim() && resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin()
        || (hasClaim() && resource.data.get('ownerUid', '') == request.auth.uid);
    }

    // Codes d'accès par joueur : admin seulement (jamais lisibles par les invités).
    match /invites/{id} {
      allow read, write: if isAdmin();
    }

    // « Qui je suis » pour un appareil invité. Création possible seulement
    // avec le bon code du joueur choisi.
    match /claims/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['playerId', 'code'])
        && request.resource.data.playerId is string
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.playerId))
        && request.resource.data.code ==
           get(/databases/$(database)/documents/invites/$(request.resource.data.playerId)).data.code;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Analyses.
    //  - lecture : admin, ou participant (son joueur figure dans playerIds),
    //              ou créateur de l'analyse ;
    //  - création : admin, ou invité (propriétaire = lui, 4 joueurs) ;
    //  - modification / suppression (donc aussi compter) : admin, ou son créateur.
    match /matches/{id} {
      allow read: if isAdmin()
        || (hasClaim() && myPlayer() in resource.data.playerIds)
        || resource.data.ownerUid == request.auth.uid;
      allow create: if isAdmin()
        || (hasClaim() && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.playerIds is list
            && request.resource.data.playerIds.size() == 4);
      allow update: if isAdmin()
        || (hasClaim() && resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.playerIds is list
            && request.resource.data.playerIds.size() == 4);
      allow delete: if isAdmin()
        || (hasClaim() && resource.data.get('ownerUid', '') == request.auth.uid);
    }
  }
}
